# ───────────────────────────────────────────────
# VETERAN CLUB 운영(프로덕션) 환경변수 템플릿
# 실제 값은 .env.production.local 또는 호스팅 플랫폼(Vercel 등)의
# 환경변수 설정에 넣으세요. 이 파일(예시)에는 실제 비밀값을 넣지 마세요.
# ───────────────────────────────────────────────

# PostgreSQL 연결 문자열 (운영 DB)
# 예) postgresql://USER:PASSWORD@HOST:5432/veteran_club?schema=public&sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/veteran_club?schema=public"

# iron-session 암호화 키 (32자 이상, 무작위). 아래 명령으로 생성:
#   openssl rand -base64 48 | cut -c1-48
SESSION_PASSWORD="GENERATE_A_STRONG_32PLUS_CHAR_SECRET"

# 외부 크론(/api/cron/snapshot) 인증 키. 아래 명령으로 생성:
#   openssl rand -hex 24
CRON_SECRET="GENERATE_A_STRONG_SECRET"

# 서버리스(Vercel) 배포 시 인프로세스 크론 비활성화(외부 크론 사용)
DISABLE_INPROCESS_CRON="true"

# 운영 환경 표시
NODE_ENV="production"
