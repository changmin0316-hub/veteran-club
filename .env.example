# ───────────────────────────────────────────────
# VETERAN CLUB 환경변수 예시 (.env.example)
#
# 이 파일에는 실제 비밀값을 넣지 마세요. 복사해서 사용:
#   - 로컬 개발:  cp .env.example .env         (또는 .env.local)
#   - 운영(Vercel): Vercel 프로젝트 > Settings > Environment Variables 에 입력
#
# 실제 비밀키/비밀번호는 문서에 적지 말고 보안 경로(비밀번호 관리자 등)로 전달하세요.
# ───────────────────────────────────────────────

# [필수] PostgreSQL 연결 문자열 (런타임 = 풀링/pooled 호스트)
# Neon 사용 시 "-pooler" 가 붙은 호스트. 애플리케이션 쿼리에 사용.
# 예) postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/veteran_club?sslmode=require
DATABASE_URL="postgresql://user:password@HOST-pooler/veteran_club?sslmode=require"

# [필수] PostgreSQL 직접 연결 문자열 (마이그레이션 / prisma db push 용 = 비-pooled)
# prisma/schema.prisma 의 directUrl 에서 사용. Neon 사용 시 "-pooler" 가 없는 호스트.
# 예) postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/veteran_club?sslmode=require
DATABASE_URL_UNPOOLED="postgresql://user:password@HOST/veteran_club?sslmode=require"

# [필수] iron-session 쿠키 암호화 키 (32자 이상, 무작위)
#   생성:  openssl rand -base64 48 | cut -c1-48
SESSION_PASSWORD="GENERATE_A_STRONG_32PLUS_CHAR_SECRET"

# [필수] 크론 엔드포인트(/api/cron/snapshot) 인증 키
#   생성:  openssl rand -hex 24
# Vercel Cron 사용 시 이 값을 Vercel 환경변수에도 넣으면 Bearer 헤더로 자동 인증됩니다.
CRON_SECRET="GENERATE_A_STRONG_SECRET"

# [운영 권장] 서버리스(Vercel) 배포 시 인프로세스 크론 끄기(외부/Vercel 크론 사용)
DISABLE_INPROCESS_CRON="true"

# [선택] 시드(prisma db seed) 실행 시 생성할 관리자 계정.
# 미지정 시 개발용 기본값(VC원장 / veteran1234)이 쓰이며, 최초 로그인 후 반드시 변경하세요.
SEED_ADMIN_NAME="관리자캐릭터명"
SEED_ADMIN_PASSWORD="강력한_초기_비밀번호"

# NODE_ENV 는 보통 플랫폼이 자동 설정합니다(local=development, Vercel=production).
# NODE_ENV="production"
